# ─── Host port binding ───────────────────────────────────────────
# MCP HTTP 服务宿主端口（默认 0.0.0.0:8765，所有网卡）
HTTP_LISTEN_HOST=0.0.0.0
HTTP_LISTEN_PORT=8765

# noVNC 宿主端口（默认 127.0.0.1:6082，仅本机访问）
# ⚠️ 改为 0.0.0.0 允许局域网访问，务必设置 NOVNC_PASSWORD
NOVNC_LISTEN_HOST=127.0.0.1
NOVNC_LISTEN_PORT=6082

# ─── Proxy (代理) ─────────────────────────────────────────────────
# Browser HTTP 代理（DuckDuckGo、Google、Bing 等搜索引擎请求）
# 示例: LAN_PROXY_SERVER=http://192.168.1.100:8117
# 留空则直连
LAN_PROXY_SERVER=

# Chromium 浏览器代理（visible browser 的 --proxy-server 参数）
VISIBLE_BROWSER_PROXY_SERVER=
# Chromium 代理绕过列表（逗号分隔，Chromium 语法）。按站点直连，例如 DeepSeek
# 是国内站不需代理：设 *deepseek.com 让 DeepSeek 直连，其他引擎仍走代理。
# VISIBLE_BROWSER_PROXY_BYPASS=<-loopback>,*deepseek.com

# HTTP 代理配置文件中的代理（proxy_profiles.json 的 "http" profile）
BROWSER_PROXY_SERVER=

# ─── 浏览器指纹策略（Google 会话稳定性） ───────────────────────
# BROWSER_STEALTH=true
#   CDP 接入长期验证过的 Chromium 时，默认【不注入】自制 JS stealth。
#   自制指纹（fake navigator/chrome/UA）可能与真实浏览器的 Client Hints、
#   TLS、OS、profile 历史不一致，反而损害已建立的浏览器信誉。
#   保持 false = 不污染真实浏览器身份。
# BROWSER_STEALTH_ON_CDP=false

# ─── Google 搜索（会话稳定性） ─────────────────────────────────
# 连续两次 Google 搜索之间的最小间隔（毫秒）
# GOOGLE_MIN_INTERVAL_MS=3000

# ─── ChatGPT 登录（可选） ──────────────────────────────────────────
CHATGPT_EMAIL=
CHATGPT_PASSWORD=

# ─── 学术论文工具 ──────────────────────────────────────────────────
ENABLE_PAPER_TOOLS=true
OPENALEX_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# ─── noVNC 密码（默认禁用） ────────────────────────────────────────
# ⚠️ 设置密码后会启用 noVNC，请务必使用强密码
# 留空则 noVNC 不会启动，这是安全默认值
NOVNC_PASSWORD=

# ─── VNC 健康检查（/health） ─────────────────────────────────────────
# noVNC 页面由 websockify 提供：x11vnc 挂了页面照样打得开，所以 /health 会真的
# 去连 RFB(5900) 和 websockify(6080)。设了 NOVNC_PASSWORD 而端口没监听时
# /health 返回 503，容器随之变成 unhealthy。不需要这层检查就设 false。
# VNC_HEALTH_CHECK=true
# 单个端口探测超时（毫秒，默认 500）
# VNC_HEALTH_TIMEOUT_MS=500
# 探测结果缓存（毫秒，默认 1000），避免监控轮询变成探测风暴
# VNC_HEALTH_CACHE_MS=1000

# ─── 安全配置 ──────────────────────────────────────────────────────
# Bearer Token 认证：设置后所有端点（除 /health）需 Authorization: Bearer <token>
# 公网暴露时必须设置
MCP_BEARER_TOKEN=

# 速率限制：每个 IP 在窗口期内的最大请求数
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── 浏览器并发与超时（ARM 等低性能设备建议调整） ───────────────────
# 资源节制总开关：true 时并发默认降到 1、拟人滚动停顿缩短（ARM/低内存设备建议 true）
# LOW_POWER_DEVICE=false
# 同时最多允许多少个浏览器页面操作（默认 2，ARM 建议 1）
# MAX_CONCURRENT_PAGES=2
# 最多同时几个登录会话 context（默认 1，ARM 保持 1）
# MAX_SESSION_CONTEXTS=1
# 浏览器操作超时（毫秒，默认 45000）
# BROWSER_TIMEOUT_MS=45000
# 连接 visible Chromium 的 CDP 超时（毫秒，默认 60000，ARM 首次启动可能需更久）
# EXISTING_CHROME_CONNECT_TIMEOUT_MS=60000
# 最大 fetch 并发数（默认 3，ARM 建议 1）
# MAX_FETCH_CONCURRENCY=3
# 关闭页面前的拟人滚动/悬停/点击（默认 true，可设 false 关闭以省 CPU）
# BROWSER_SIMULATE_BROWSING=true

# ─── 多客户端并发与拥塞控制 ──────────────────────────────────────────
# 浏览器类引擎共用同一个 Chromium，可用页面数 = MAX_CONCURRENT_PAGES。
# 槽位占满时后来的请求进入等待队列；下列参数决定"排队"的表现，
# 防止一个卡死的引擎把整台机器的浏览器永久占住（旧行为：page queue full 直到重启）。
#
# 等待队列长度上限（默认 max(4, MAX_CONCURRENT_PAGES*4)）。
# 超出直接返回 PAGE_QUEUE_FULL 快速失败，不再无限堆积挂起的请求。
# MAX_PAGE_QUEUE_WAITERS=8
#
# 排队等槽位的最长时间（毫秒，默认 60000，下限 1000）。
# 超时返回 PAGE_BUSY 并附 retry_hint；低配设备建议调小让客户端尽早降级
# 真正生效的上限是 min(本值, 调用方剩余预算)：引擎/工具时限更短时会被提前拒绝，
# 不会排到自己的超时之后才失败。
# PAGE_QUEUE_TIMEOUT_MS=60000
#
# 有人排队时是否仍保留"读完再关页"的拟人停留（默认 false）。
# false = 有等待者时跳过 1.5~12s 的停留，把槽位立刻让给下一个请求
# BROWSER_KEEP_LINGER_UNDER_LOAD=false
#
# 关页收尾（写回 cookie / about:blank / close）最多占用槽位多少毫秒（默认 3000，下限 100）。
# 页面卡死时 storageState()/page.close() 会阻塞几十秒甚至永不返回，而"被取消的请求"
# 恰恰最容易留下卡死的页面；超时后先释放槽位给下一个客户端，关闭动作转后台继续。
# 不设这个上限，1 槽位设备会被一个死页面占住直到重启（page queue full）。
# PAGE_TEARDOWN_TIMEOUT_MS=3000
#
# 上面这份预算是「写回 cookie + about:blank 导航 + close」三步共享的；本值是 close
# 至少保住的毫秒数（默认 1200，下限 0）。慢机器上前两步就能把预算耗光，而 0 预算的
# close 会被立刻放弃 —— 被放弃的 close 恰恰就是把标签页留在可见浏览器里的那种：此时
# 页面已经导航到 about:blank，正是用户看到越攒越多的那一片空白页。
# PAGE_CLOSE_MIN_TEARDOWN_MS=1200
#
# 剩余预算低于该值时收尾步骤直接跳过，而不是「先启动再干等」（默认 250，下限 0，
# 0 = 关闭该保护）。只剩几十毫秒时 goto('about:blank') 必然等不到，反而留下一趟在飞的
# 导航让 close 更容易卡住；这一步宁可不做。
# MIN_AWAITABLE_STEP_MS=250
#
# 已经「叫它关」的页面还能等多久（默认 5000，下限 500）。被放弃过一次 close 的页面不会
# 再接受第二次：Playwright 记住了第一次调用，之后每次都立刻返回而不去碰标签页，所以从
# 页面对象的角度看这个标签页永远关不掉。超过本值就改用 DevTools 协议关掉它背后的
# target。engine_status 里的 wedged_pages 就是这个数，正常应长期为 0。
# PAGE_CLOSE_WEDGE_MS=5000
#
# 回收线程的间隔（毫秒，默认 30000，低配设备 20000，0 关闭）。除了上面被放弃的 close，
# 它还负责回收点击搜索结果新开的标签页，以及无法归属到任何任务的 about:blank 残留页。
# PAGE_REAPER_INTERVAL_MS=30000
#
# 页面无主多久之后回收线程才动手；无法归属的空白页还要求被清扫到两次（默认 15000，
# 下限 2000）。清扫是在真实搜索进行中也会跑的，所以这个宽限期故意留得宽松。
# PAGE_ORPHAN_GRACE_MS=15000
#
# 回收线程替一个卡死页面做的协议往返的时间上限（毫秒，默认 2000，下限 100）。
# 连这些都答不出来的浏览器也已经不值得再连了。
# PAGE_PROTOCOL_TIMEOUT_MS=2000
#
# 彻底救不回来的页面（拿不到协议会话，或该标签页正好是浏览器里的最后一页）留在台账中的
# 最长时间（默认 120000，下限 5000）；到期从台账移除，避免台账无界增长。
# PAGE_LEDGER_MAX_MS=120000
#
# 是否回收「无法归属」的 about:blank 标签页（默认 true，false 关闭）。CDP 模式下搜索
# context 就是用户自己的浏览器 profile，人手动开的标签页与泄漏无法区分，因此默认策略是
# 「未经证明都是别人的」，并且只按 URL 恰好等于 about:blank 这一条回收：池子自己在关页
# 前会导航到这里，而人在读的标签页不会。CDP 模式下还绝不会把一个 context 关到只剩最后
# 一页 —— 那一页就是窗口。
# BROWSER_REAP_STRAY_BLANK_PAGES=true
#
# 上面那条管的是「池子开过的页」和「无法归属的空白页」；连接建立的那一刻就已经开着的
# 标签页（可见浏览器的启动页、持久化 profile 恢复出来的窗口）算别人的，清扫永远不碰。
# 如果这个浏览器从头到尾只由本服务开标签页，设成 true 把那些空白页一并回收 ——
# Docker/可见浏览器「查完一轮还剩一片 about:blank」就是这个开关没开。
# BROWSER_REAP_FOREIGN_BLANK_PAGES=false
#
# 跨「CDP 连接断开再重连」记住我们自己开过哪些标签页的条数上限（默认 256，下限 16）。
# 重连之后 Playwright 的 Page 对象全部作废换新，光靠对象身份会把上一辈子我们留下的页
# 误判成别人开的，从此再也收不回来（表现为空白页只增不减）。因此池子额外记住
# target id，重连时按 id 把它们重新认领回自己名下，交给清扫处理。
# PAGE_OWNERSHIP_MAX=256
#
# 挂在"等人验证"状态而保留不关的页面数上限（默认 4，低配设备 2，下限 1）。
# 命中验证码/风控的页面会 keepPageOpen 保留，供人在 noVNC 里手动过验证；
# 它们不计入 MAX_CONCURRENT_PAGES，只靠 KEPT_PAGE_TTL_MS(默认 5min) 过期，
# 而 launch 模式下每个这样的页面还各自独占一个 context。多客户端同时抓风控站点
# 就会攒出一堆常驻 Chromium，把 MAX_CONCURRENT_PAGES=1 的小机器压垮。
# 超限时先淘汰临时（非会话）页面，其余按最早优先淘汰。
# MAX_KEPT_PAGES=4
#
# 关停阶段每一步（chrome-devtools MCP / 浏览器池 / HTTP 服务）的时间上限
# （毫秒，默认 3000，下限 0）。卡死的 page.close() 或一直不断开的 SSE 客户端
# 会让 pool.close()/server.close() 永不返回，进程退不出去就等于整份 Chromium
# 一直常驻；超时后打一行日志继续退出。
# SHUTDOWN_STEP_TIMEOUT_MS=3000
#
# DuckDuckGo 限速（2s 最小间隔）等待队列上限（默认 8）。
# 超出返回 DDG_THROTTLED，避免几十个客户端一起挂在限速等待上
# DUCKDUCKGO_MAX_QUEUED=8
#
# DuckDuckGo 端点阶梯顺序（空闲时，默认 main,html,lite）。main = 主站
# duckduckgo.com/?q=，是它 robots.txt 里唯一放行的 SERP（/html、/lite 都被
# Disallow，且结果来自 Bing）。有客户端排队等页面槽时自动改成最省优先
# （lite,html,main），低配机上少占槽位。设为 main 即关闭阶梯。
# DUCKDUCKGO_ENDPOINTS=main,html,lite
#
# 两次 DuckDuckGo 请求之间的最小间隔（毫秒，默认 2000，下限 0）。共享/机房
# 出口 IP 可调大以少触发 202 挑战页；压测或低延迟场景置 0。
# DUCKDUCKGO_MIN_INTERVAL_MS=2000
#
# ChatGPT 串行队列上限（默认 4）。多个客户端共用同一个登录标签页，
# 一次只跑一个提问，超出返回 CHATGPT_BUSY
# CHATGPT_MAX_QUEUED=4
#
# MCP 客户端断开/超时后会立刻取消正在跑的引擎与浏览器任务（ABORTED），
# 不再留下无人读取的任务占住槽位；单个引擎超时见 ENGINE_TIMEOUT_MS
# ENGINE_TIMEOUT_MS=
#
# search_web / search_and_fetch 在服务端自身的总时限（毫秒，默认 240000，下限 500）。
# DeepSeek → Google AI → DeepSeek 验证链在 ARM/受限出口上实测可达 ~135s，闸门低于它就会把
# 整条链已经成功的结果砍成 TIMEOUT。MCP 客户端超时（opencode 的 timeout）必须不小于这两个值：
# 客户端先放弃会顺带取消服务端任务，正在跑的工作全部作废。
# SEARCH_TOOL_TIMEOUT_MS=240000
# BUNDLE_TOOL_TIMEOUT_MS=240000
#
# /mcp-stream 会话空闲多久后回收（毫秒，默认 3600000=1h，下限 60000）。
# 客户端频繁重连时按空闲回收，避免旧会话堆积
# SESSION_IDLE_TTL_MS=3600000
#
# 同时保留的 /mcp-stream 会话数上限（默认 500）
# MAX_STREAMABLE_SESSIONS=500
# 同时存活的 /sse 传输数上限（默认 500）
# MAX_SSE_TRANSPORTS=500

# ─── 日志噪声 ────────────────────────────────────────────────────────
# 正文抽取用 jsdom，它不认识现代 CSS（@layer / :is() / color-mix() / 转义选择器），
# 每个 <style> 块都会抛一次 "Error: Could not parse CSS stylesheet" 并把整段样式
# 打到 stderr（AstroWind、Chakra 等站点每次抓取刷屏十几条）。
# 抽取只读 DOM 文本，不读 CSSOM，因此默认丢弃这类噪声；设为 true 可恢复用于排障。
# EXTRACT_DEBUG_CSS_ERRORS=false

# ─── DeepSeek 引擎输出 ────────────────────────────────────────────
# 答案返回长度（默认 20000，保留完整信息；调大以取更完整回答）
# DEEPSEEK_MAX_SNIPPET=20000
# 是否保留 DeepThink 思考链（默认 true）
# DEEPSEEK_INCLUDE_REASONING=true
# 思考链返回长度（默认 8000）
# DEEPSEEK_MAX_REASONING=8000
# prompt 层自我验证：true 时让 DeepSeek 区分确凿事实/推断、给关键数据附依据、标注不确定性
# DEEPSEEK_VERIFY=false
# 等待 DeepSeek 回复的超时（毫秒，默认 150000）
# DEEPSEEK_TIMEOUT_MS=150000
# 保存 DeepSeek 对话轨迹（prompt / 思考链 / 回答）到指定目录，JSONL 追加式，供后续处理。
# DEEPSEEK_TRACE_ENABLED=false
# DEEPSEEK_TRACE_DIR=/data/traces
# 交叉验证链：DeepSeek 首答 → Google AI 求证 → Google 回复贴回 DeepSeek 综合验证。
# 需 Google AI Mode（google 会话登录）。Google 不可用时自动跳过验证并提示，返回 DeepSeek 普通回答。
# DEEPSEEK_VALIDATE=false
# 每步（DeepSeek 首答 / Google AI / DeepSeek 综合）失败时的重试次数，应对网络不稳定。
# DEEPSEEK_RETRY=3
# DeepSeek 输入长度上限（字符），超长直接返回明确错误，避免卡住超时。
# DEEPSEEK_MAX_INPUT_CHARS=2000

# ─── 会话恢复（localStorage） ─────────────────────────────────────
# 默认 false：恢复会话时只加 cookies（登录态），不按 origin 逐个开页面写 localStorage。
# 会话文件可能含几十个无关站点（github/medium 等），逐个开页会导致 tab 狂切 + 高 CPU。
# 仅在确实需要恢复某站点 localStorage 时设 true，并用 MAX_ORIGINS 限制页数。
# BROWSER_RESTORE_LOCALSTORAGE=false
# BROWSER_RESTORE_MAX_ORIGINS=3

# ─── Docker 内存上限（compose 顶层，由 .env 控制） ─────────────────
# 容器内存上限（0=不限制）。低内存/ARM 设备建议 2g，防止 Chromium OOM 拖垮宿主
# MEM_LIMIT=2g
# 共享内存（Chromium 依赖，默认 1gb）
# SHM_SIZE=1gb
# 注意：CPU 上限（cpus/NanoCPUs）在部分内核（cgroup 未挂载）不支持，故不提供；
# CPU 节制请用上面的 LOW_POWER_DEVICE + MAX_*_CONCURRENCY 软件并发参数。

# ─── 其他可选参数 ──────────────────────────────────────────────────
# 默认时区（get_time 工具，留空则使用服务器本地时区）
TIMEZONE=
