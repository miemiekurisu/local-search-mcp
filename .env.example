# ─── Host port binding ───────────────────────────────────────────
# MCP HTTP 服务宿主端口（默认 0.0.0.0:8765，所有网卡）
HTTP_LISTEN_HOST=0.0.0.0
HTTP_LISTEN_PORT=8765

# noVNC 宿主端口（默认 127.0.0.1:6082，仅本机访问）
# ⚠️ 改为 0.0.0.0 允许局域网访问，务必设置 NOVNC_PASSWORD
NOVNC_LISTEN_HOST=127.0.0.1
NOVNC_LISTEN_PORT=6082

# ─── Proxy (代理) ─────────────────────────────────────────────────
# Browser HTTP 代理（DuckDuckGo、Google、Bing 等搜索引擎请求）
# 示例: LAN_PROXY_SERVER=http://192.168.1.100:8117
# 留空则直连
LAN_PROXY_SERVER=

# Chromium 浏览器代理（visible browser 的 --proxy-server 参数）
VISIBLE_BROWSER_PROXY_SERVER=
# Chromium 代理绕过列表（逗号分隔，Chromium 语法）。按站点直连，例如 DeepSeek
# 是国内站不需代理：设 *deepseek.com 让 DeepSeek 直连，其他引擎仍走代理。
# VISIBLE_BROWSER_PROXY_BYPASS=<-loopback>,*deepseek.com

# HTTP 代理配置文件中的代理（proxy_profiles.json 的 "http" profile）
BROWSER_PROXY_SERVER=

# ─── 浏览器指纹策略（Google 会话稳定性） ───────────────────────
# BROWSER_STEALTH=true
#   CDP 接入长期验证过的 Chromium 时，默认【不注入】自制 JS stealth。
#   自制指纹（fake navigator/chrome/UA）可能与真实浏览器的 Client Hints、
#   TLS、OS、profile 历史不一致，反而损害已建立的浏览器信誉。
#   保持 false = 不污染真实浏览器身份。
# BROWSER_STEALTH_ON_CDP=false

# ─── Google 搜索（会话稳定性） ─────────────────────────────────
# 连续两次 Google 搜索之间的最小间隔（毫秒）
# GOOGLE_MIN_INTERVAL_MS=3000

# ─── ChatGPT 登录（可选） ──────────────────────────────────────────
CHATGPT_EMAIL=
CHATGPT_PASSWORD=

# ─── 学术论文工具 ──────────────────────────────────────────────────
ENABLE_PAPER_TOOLS=true
OPENALEX_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# ─── noVNC 密码（默认禁用） ────────────────────────────────────────
# ⚠️ 设置密码后会启用 noVNC，请务必使用强密码
# 留空则 noVNC 不会启动，这是安全默认值
NOVNC_PASSWORD=

# ─── 安全配置 ──────────────────────────────────────────────────────
# Bearer Token 认证：设置后所有端点（除 /health）需 Authorization: Bearer <token>
# 公网暴露时必须设置
MCP_BEARER_TOKEN=

# 速率限制：每个 IP 在窗口期内的最大请求数
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── 浏览器并发与超时（ARM 等低性能设备建议调整） ───────────────────
# 资源节制总开关：true 时并发默认降到 1、拟人滚动停顿缩短（ARM/低内存设备建议 true）
# LOW_POWER_DEVICE=false
# 同时最多允许多少个浏览器页面操作（默认 2，ARM 建议 1）
# MAX_CONCURRENT_PAGES=2
# 最多同时几个登录会话 context（默认 1，ARM 保持 1）
# MAX_SESSION_CONTEXTS=1
# 浏览器操作超时（毫秒，默认 45000）
# BROWSER_TIMEOUT_MS=45000
# 连接 visible Chromium 的 CDP 超时（毫秒，默认 60000，ARM 首次启动可能需更久）
# EXISTING_CHROME_CONNECT_TIMEOUT_MS=60000
# 最大 fetch 并发数（默认 3，ARM 建议 1）
# MAX_FETCH_CONCURRENCY=3
# 关闭页面前的拟人滚动/悬停/点击（默认 true，可设 false 关闭以省 CPU）
# BROWSER_SIMULATE_BROWSING=true

# ─── DeepSeek 引擎输出 ────────────────────────────────────────────
# 答案返回长度（默认 20000，保留完整信息；调大以取更完整回答）
# DEEPSEEK_MAX_SNIPPET=20000
# 是否保留 DeepThink 思考链（默认 true）
# DEEPSEEK_INCLUDE_REASONING=true
# 思考链返回长度（默认 8000）
# DEEPSEEK_MAX_REASONING=8000
# prompt 层自我验证：true 时让 DeepSeek 区分确凿事实/推断、给关键数据附依据、标注不确定性
# DEEPSEEK_VERIFY=false
# 等待 DeepSeek 回复的超时（毫秒，默认 150000）
# DEEPSEEK_TIMEOUT_MS=150000
# 保存 DeepSeek 对话轨迹（prompt / 思考链 / 回答）到指定目录，JSONL 追加式，供后续处理。
# DEEPSEEK_TRACE_ENABLED=false
# DEEPSEEK_TRACE_DIR=/data/traces
# 交叉验证链：DeepSeek 首答 → Google AI 求证 → Google 回复贴回 DeepSeek 综合验证。
# 需 Google AI Mode（google 会话登录）。Google 不可用时自动跳过验证并提示，返回 DeepSeek 普通回答。
# DEEPSEEK_VALIDATE=false
# 每步（DeepSeek 首答 / Google AI / DeepSeek 综合）失败时的重试次数，应对网络不稳定。
# DEEPSEEK_RETRY=3
# DeepSeek 输入长度上限（字符），超长直接返回明确错误，避免卡住超时。
# DEEPSEEK_MAX_INPUT_CHARS=2000

# ─── 会话恢复（localStorage） ─────────────────────────────────────
# 默认 false：恢复会话时只加 cookies（登录态），不按 origin 逐个开页面写 localStorage。
# 会话文件可能含几十个无关站点（github/medium 等），逐个开页会导致 tab 狂切 + 高 CPU。
# 仅在确实需要恢复某站点 localStorage 时设 true，并用 MAX_ORIGINS 限制页数。
# BROWSER_RESTORE_LOCALSTORAGE=false
# BROWSER_RESTORE_MAX_ORIGINS=3

# ─── Docker 内存上限（compose 顶层，由 .env 控制） ─────────────────
# 容器内存上限（0=不限制）。低内存/ARM 设备建议 2g，防止 Chromium OOM 拖垮宿主
# MEM_LIMIT=2g
# 共享内存（Chromium 依赖，默认 1gb）
# SHM_SIZE=1gb
# 注意：CPU 上限（cpus/NanoCPUs）在部分内核（cgroup 未挂载）不支持，故不提供；
# CPU 节制请用上面的 LOW_POWER_DEVICE + MAX_*_CONCURRENCY 软件并发参数。

# ─── 其他可选参数 ──────────────────────────────────────────────────
# 默认时区（get_time 工具，留空则使用服务器本地时区）
TIMEZONE=
